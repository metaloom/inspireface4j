<project xmlns="http://maven.apache.org/POM/4.0.0"
    xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
    xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 http://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>

    <groupId>io.metaloom.facedetect4j</groupId>
    <artifactId>facedetect4j-parent</artifactId>
    <version>0.1.0-SNAPSHOT</version>
    <packaging>pom</packaging>

    <parent>
        <groupId>io.metaloom</groupId>
        <artifactId>maven-parent</artifactId>
        <version>3.0.0-SNAPSHOT</version>
    </parent>

    <modules>
        <module>api</module>
        <module>yunet</module>
        <module>inspireface</module>
        <module>jdlib</module>
    </modules>

    <name>facedetect4j-parent</name>
    <url>https://github.com/metaloom/facedetect4j</url>
    <description>A Java library for face detection and face embedding extraction</description>
    <inceptionYear>2026</inceptionYear>

    <developers>
        <developer>
            <id>jotschi</id>
            <name>Johannes Schüth</name>
            <roles>
                <role>Maintainer</role>
            </roles>
            <email>git@jotschi.de</email>
            <organization>MetaLoom</organization>
        </developer>
    </developers>

    <licenses>
        <license>
            <name>Apache License, Version 2.0</name>
            <url>http://www.apache.org/licenses/LICENSE-2.0.txt</url>
            <distribution>repo</distribution>
            <comments>A business-friendly OSS license</comments>
        </license>
    </licenses>

    <properties>
        <project.build.sourceEncoding>UTF-8</project.build.sourceEncoding>
        <!--
          video4j and opencv-ffm share a version line that tracks the OpenCV they bind, so 4.10.0
          here means OpenCV 4.10 and the two must be bumped together. opencv-ffm arrives
          transitively through video4j but is pinned anyway: it decides which OpenCV natives land
          in the JVM, and inspireface's own shim has to be built against the same major.
        -->
        <video4j.version>4.10.0-SNAPSHOT</video4j.version>
        <opencv-ffm.version>4.10.0-SNAPSHOT</opencv-ffm.version>
        <!--
          onnxruntime_gpu, not onnxruntime: the CPU artifact contains no CUDA execution provider,
          so Device.cuda() could never be satisfied with it. The Maven artifact is a CUDA 12 build
          and needs no cuDNN - see the yunet README.
        -->
        <onnxruntime.version>1.28.0</onnxruntime.version>
        <assertj.version>3.27.3</assertj.version>
        <snippet-filter.version>0.1.1</snippet-filter.version>
    </properties>

    <dependencyManagement>
        <dependencies>
            <dependency>
                <groupId>io.metaloom.facedetect4j</groupId>
                <artifactId>facedetect4j-api</artifactId>
                <version>${project.version}</version>
            </dependency>
            <!-- Carries TestData, the locator for the shared testdata/ media. -->
            <dependency>
                <groupId>io.metaloom.facedetect4j</groupId>
                <artifactId>facedetect4j-api</artifactId>
                <version>${project.version}</version>
                <type>test-jar</type>
                <scope>test</scope>
            </dependency>
            <dependency>
                <groupId>io.metaloom.facedetect4j</groupId>
                <artifactId>facedetect4j-yunet</artifactId>
                <version>${project.version}</version>
            </dependency>
            <dependency>
                <groupId>io.metaloom.facedetect4j</groupId>
                <artifactId>facedetect4j-inspireface</artifactId>
                <version>${project.version}</version>
            </dependency>
            <dependency>
                <groupId>io.metaloom.facedetect4j</groupId>
                <artifactId>facedetect4j-jdlib</artifactId>
                <version>${project.version}</version>
            </dependency>

            <dependency>
                <groupId>com.microsoft.onnxruntime</groupId>
                <artifactId>onnxruntime_gpu</artifactId>
                <version>${onnxruntime.version}</version>
            </dependency>
            <dependency>
                <groupId>io.metaloom.video</groupId>
                <artifactId>video4j</artifactId>
                <version>${video4j.version}</version>
            </dependency>
            <dependency>
                <groupId>io.metaloom.opencv</groupId>
                <artifactId>opencv-ffm</artifactId>
                <version>${opencv-ffm.version}</version>
            </dependency>
            <dependency>
                <groupId>org.assertj</groupId>
                <artifactId>assertj-core</artifactId>
                <version>${assertj.version}</version>
            </dependency>
            <dependency>
                <groupId>commons-io</groupId>
                <artifactId>commons-io</artifactId>
                <version>2.11.0</version>
            </dependency>
        </dependencies>
    </dependencyManagement>

    <dependencies>
        <!-- Logging -->
        <dependency>
            <groupId>org.slf4j</groupId>
            <artifactId>slf4j-api</artifactId>
        </dependency>

        <!-- Test -->
        <dependency>
            <groupId>ch.qos.logback</groupId>
            <artifactId>logback-classic</artifactId>
            <scope>test</scope>
        </dependency>
        <dependency>
            <groupId>org.junit.jupiter</groupId>
            <artifactId>junit-jupiter</artifactId>
            <scope>test</scope>
        </dependency>
        <!--
          Reactor-wide because AbstractFacePipelineTest (shipped in the api test-jar) asserts with
          it, so every module running the shared conformance suite needs it on the test classpath.
        -->
        <dependency>
            <groupId>org.assertj</groupId>
            <artifactId>assertj-core</artifactId>
            <scope>test</scope>
        </dependency>
    </dependencies>

    <build>
        <plugins>
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-surefire-plugin</artifactId>
                <configuration>
                    <!--
                      Both backends reach native code: inspireface via FFM downcalls, yunet via
                      the ONNX Runtime JNI library. Without this the JVM prints a warning today
                      and will refuse the call in a later release.
                    -->
                    <argLine>--enable-native-access=ALL-UNNAMED</argLine>
                </configuration>
            </plugin>

            <!--
              README generation. Each module keeps its source of truth in .github/md/README.md and
              the rendered README.md at its root is generated during `clean` - never edit the
              generated file. The snippet filter inlines code from the tests, so the examples in
              the README cannot drift away from code that actually compiles.
            -->
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-resources-plugin</artifactId>
                <executions>
                    <execution>
                        <id>readme-md</id>
                        <phase>clean</phase>
                        <goals>
                            <goal>copy-resources</goal>
                        </goals>
                        <configuration>
                            <outputDirectory>${project.basedir}</outputDirectory>
                            <resources>
                                <resource>
                                    <directory>${project.basedir}/.github/md</directory>
                                    <includes>
                                        <include>README.md</include>
                                    </includes>
                                    <filtering>true</filtering>
                                </resource>
                            </resources>
                            <encoding>UTF-8</encoding>
                            <mavenFilteringHints>
                                <mavenFilteringHint>snippetFilter</mavenFilteringHint>
                            </mavenFilteringHints>
                        </configuration>
                    </execution>
                </executions>
                <dependencies>
                    <dependency>
                        <groupId>io.metaloom.maven</groupId>
                        <artifactId>snippet-resource-filter</artifactId>
                        <version>${snippet-filter.version}</version>
                    </dependency>
                </dependencies>
            </plugin>
        </plugins>
    </build>
</project>
